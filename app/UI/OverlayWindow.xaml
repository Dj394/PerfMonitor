<Window x:Class="PerfMonitorLive.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PerfMonitor overlay" Width="720" Height="52" SizeToContent="Width"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="13">
    <Border CornerRadius="0,0,14,14" Background="#E0141A22" BorderBrush="#334A5568" BorderThickness="1,0,1,1" Padding="16,8">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="GameText" Text="🎮 Jeu" Foreground="#8C97A8" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock x:Name="CpuText" Foreground="#E8ECF2" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TempText" Foreground="#E8ECF2" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="GpuText" Foreground="#E8ECF2" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="MemText" Foreground="#E8ECF2" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="DiskText" Foreground="#E8ECF2" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ClockText" Foreground="#8C97A8" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
