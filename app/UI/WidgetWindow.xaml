<Window x:Class="PerfMonitorLive.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PerfMonitor widget" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="12.5">
    <Border x:Name="Card" CornerRadius="12" Background="{DynamicResource ToastBgBrush}" BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1" Padding="12,7" Cursor="SizeAll"
            ToolTip="PerfMonitor Live — glisser pour déplacer, clic droit pour le menu, double-clic pour ouvrir">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Ouvrir PerfMonitor Live" Click="Open_Click"/>
                <MenuItem Header="Ramener sur l'écran des notifications" Click="Reset_Click"/>
                <Separator/>
                <MenuItem Header="Masquer le widget" Click="Hide_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Orientation="Horizontal">
            <Border Width="18" Height="18" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B8BFF" Offset="0"/><GradientStop Color="#8A5CFF" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <TextBlock x:Name="T1" Foreground="{DynamicResource FgBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="T2" Foreground="{DynamicResource FgBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="T3" Foreground="{DynamicResource FgBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="T4" Foreground="{DynamicResource FgBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="T5" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
