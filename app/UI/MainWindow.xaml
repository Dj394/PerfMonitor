<Window x:Class="PerfMonitorLive.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PerfMonitorLive.UI"
        Title="PerfMonitor Live" Width="1180" Height="800" MinWidth="740" MinHeight="520"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="Manual" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/app-icon.png">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:PctToWidth x:Key="P2W"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/><Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#1B222C"/><Setter Property="Padding" Value="6,4"/></Style>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}"/><Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="B" Padding="16,8" Margin="0,0,6,0" CornerRadius="10" Background="Transparent">
                            <ContentPresenter ContentSource="Header" TextBlock.Foreground="{DynamicResource MutedBrush}" TextBlock.FontWeight="Medium"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource TabSelBrush}"/>
                                <Setter TargetName="B" Property="TextBlock.Foreground" Value="{DynamicResource TitleFgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource TabHoverBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Ascenseur fin et arrondi -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Th" CornerRadius="4" Background="{DynamicResource ScrollThumbBrush}" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Th" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Th" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border CornerRadius="5" Background="{DynamicResource ScrollTrackBrush}" Margin="1"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Boutons de la barre de titre -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TitleFgBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E0424E"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/></Style>
        <Style x:Key="Section" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="BorderBrush" Value="{DynamicResource GridBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
    </Window.Resources>

    <DockPanel>
        <!-- Barre de titre personnalisée -->
        <Border DockPanel.Dock="Top" Padding="16,0,8,0" Height="64" Background="{DynamicResource HeaderBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Réduire"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Agrandir"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fermer (reste dans la zone de notification)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#5A7CFF" Opacity="0.55"/></Border.Effect>
                        <Image Source="pack://application:,,,/app-icon.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PerfMonitor Live" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleFgBrush}"/>
                            <TextBlock x:Name="VersionText" Text="v3.0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <Border x:Name="StatusPill" CornerRadius="14" Padding="12,5" Margin="18,0,0,0" VerticalAlignment="Center" Background="#2A3D33">
                        <TextBlock x:Name="StatusPillText" Text="✅  Tout est normal" Foreground="#3DD68C" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="14" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Panel2Brush}" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" ToolTip="Profil de seuils actif — cliquer pour changer" MouseLeftButtonUp="ProfilePill_Click">
                        <TextBlock x:Name="ProfilePillText" Text="👤 Travail" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <Popup x:Name="ProfilePopup" StaysOpen="False" Placement="Mouse" AllowsTransparency="True">
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GridBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                            <StackPanel>
                                <Button Content="⚙️ Automatique (jeu / nuit / travail)" Tag="Auto" Click="Profile_Click" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                                <Button Content="💼 Travail" Tag="Travail" Click="Profile_Click" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                                <Button Content="🎮 Jeu (critiques seulement)" Tag="Jeu" Click="Profile_Click" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                                <Button Content="🌙 Nuit" Tag="Nuit" Click="Profile_Click" HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="PauseBtn" Content="🔕  Pause 1 h" Margin="0,0,8,0" Click="Pause_Click"/>
                    <Button Content="🔔  Tester une notif" Margin="0,0,8,0" Click="Test_Click"/>
                    <Button Content="📊  Rapport 24 h" Style="{StaticResource PrimaryButton}" Click="Report_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource HeaderLineBrush}"/>

        <TabControl x:Name="Tabs" Background="Transparent" Foreground="{DynamicResource FgBrush}" BorderThickness="0" Margin="14,12,14,14" Padding="0,10,0,0">
            <!-- LIVE -->
            <TabItem Header="⚡  Live">
                <Grid>
                    <ScrollViewer x:Name="LiveScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="LiveScroll_SizeChanged">
                        <ItemsControl x:Name="Cards" Height="{Binding GridHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding Cols, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="14,12,14,12" Margin="5" MinHeight="{Binding CardMinHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderBrush="{Binding CardBorder}" BorderThickness="1" Tag="{Binding Key}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Background="{Binding TrendBg}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TrendText}" Foreground="{Binding TrendBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel Grid.Row="1" Margin="0,4,0,6">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SubText}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" VerticalAlignment="Bottom" Margin="8,0,0,4" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ValueText}" FontSize="{Binding ValueFontSize, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Foreground="{Binding LevelBrush}"/>
                                            </DockPanel>
                                            <Border Grid.Row="2" Height="6" CornerRadius="3" Background="{DynamicResource SparkBgBrush}" Margin="0,0,0,8" Visibility="{Binding GaugeVisible}">
                                                <Border Width="{Binding GaugeWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding LevelBrush}"/>
                                            </Border>
                                            <Border Grid.Row="3" CornerRadius="8" Background="{DynamicResource SparkBgBrush}" ClipToBounds="True" MinHeight="58">
                                                <Canvas ClipToBounds="True" SizeChanged="Spark_SizeChanged">
                                                    <Path Data="{Binding AreaGeom}" Fill="{Binding LevelSoft}"/>
                                                    <Line X1="0" X2="{Binding SparkW}" Y1="{Binding ThresholdY}" Y2="{Binding ThresholdY}" Stroke="#80FF5D6C" StrokeThickness="1" StrokeDashArray="3,3" Visibility="{Binding ThresholdVisible}"/>
                                                    <Path Data="{Binding FlatGeom}" Stroke="{Binding LevelBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Path Data="{Binding UpGeom}" Stroke="#FF5D6C" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Path Data="{Binding DownGeom}" Stroke="#3DD68C" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Border>
                                            <Border Grid.Row="4" Margin="0,10,0,0" Padding="8,6" CornerRadius="8" Background="{DynamicResource Panel2Brush}" Visibility="{Binding HasRule, Converter={StaticResource B2V}}">
                                                <WrapPanel>
                                                    <CheckBox IsChecked="{Binding Enabled}" Content="Alerte ≥" Margin="0,0,5,0" ToolTip="Activer / désactiver la notification pour cette métrique"/>
                                                    <TextBox Text="{Binding Threshold, UpdateSourceTrigger=LostFocus}" Width="50" TextAlignment="Right" ToolTip="Seuil"/>
                                                    <TextBlock Text="{Binding Unit}" Foreground="{DynamicResource MutedBrush}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="pendant" Foreground="{DynamicResource MutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding Sustain, UpdateSourceTrigger=LostFocus}" Width="46" TextAlignment="Right" ToolTip="Durée pendant laquelle le seuil doit être dépassé avant d'alerter"/>
                                                    <TextBlock Text="s" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </WrapPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Conseiller volant -->
                    <Canvas x:Name="AdvisorLayer" IsHitTestVisible="True" Background="{x:Null}">
                        <Border x:Name="Bubble" Canvas.Left="200" Canvas.Top="80" Width="330" Visibility="Collapsed" Cursor="Arrow"
                                Background="{DynamicResource BubbleBgBrush}" BorderBrush="#5AB4FF" BorderThickness="1" CornerRadius="14" Padding="14,12">
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#000000" Opacity="0.5"/></Border.Effect>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" x:Name="BubbleKind" Text="💡 conseil" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BubbleTitle" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TitleFgBrush}" TextWrapping="Wrap"/>
                                </DockPanel>
                                <TextBlock x:Name="BubbleText" Margin="0,6,0,10" TextWrapping="Wrap" Foreground="{DynamicResource BubbleFgBrush}" FontSize="12.5" LineHeight="18"/>
                                <WrapPanel>
                                    <Button Content="Suivant ➜" Padding="10,4" Margin="0,0,6,4" Click="AdvNext_Click"/>
                                    <Button Content="Compris" Padding="10,4" Margin="0,0,6,4" Click="AdvOk_Click" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="Ne plus montrer" Padding="10,4" Margin="0,0,6,4" Click="AdvDismiss_Click"/>
                                    <Button Content="Masquer le conseiller" Padding="10,4" Margin="0,0,0,4" Click="AdvHide_Click" Foreground="{DynamicResource MutedBrush}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Grid x:Name="Mascot" Canvas.Left="40" Canvas.Top="40" Width="58" Height="58" Cursor="Hand" ToolTip="Le conseiller — clique-moi pour un conseil" MouseLeftButtonUp="Mascot_Click">
                            <Grid.RenderTransform><TranslateTransform x:Name="MascotBob"/></Grid.RenderTransform>
                            <Ellipse Fill="#5AB4FF" Opacity="0.25" Margin="-8"><Ellipse.Effect><BlurEffect Radius="16"/></Ellipse.Effect></Ellipse>
                            <Border CornerRadius="18">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B8BFF" Offset="0"/><GradientStop Color="#8A5CFF" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#5A7CFF" Opacity="0.7"/></Border.Effect>
                            </Border>
                            <Path Data="M 14,10 L 22,6 L 30,9 L 44,3" Stroke="#CCFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Ellipse Width="13" Height="15" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13,17,0,0"/>
                            <Ellipse Width="13" Height="15" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,17,0,0"/>
                            <Ellipse x:Name="PupilL" Width="6" Height="7" Fill="#1B2440" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,21,0,0"/>
                            <Ellipse x:Name="PupilR" Width="6" Height="7" Fill="#1B2440" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36,21,0,0"/>
                            <Path Data="M 19,39 Q 29,48 39,39" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Canvas>
                </Grid>
            </TabItem>

            <!-- HISTORIQUE -->
            <TabItem Header="📈  Historique">
                <local:HistoryView x:Name="History"/>
            </TabItem>

            <!-- PROCESSUS -->
            <TabItem Header="🧩  Processus">
                <Border Style="{StaticResource Section}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Processus les plus gourmands" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="Mise à jour toutes les 3 s · CPU rapporté à tous les cœurs · Δ = évolution mémoire sur 1 h (détecteur de fuites)" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Processus" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="CPU" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="RAM" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right"/><TextBlock Grid.Column="3" Text="Handles" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="Δ 1 h" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right"/>
                        </Grid>
                        <ItemsControl x:Name="Procs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Cpu, StringFormat={}{0:0.0} %}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Mem, StringFormat={}{0:0} Mo}" TextAlignment="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Handles, StringFormat={}{0:0}}" TextAlignment="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Delta}" TextAlignment="Right" Foreground="{Binding DeltaBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="5" Height="10" Margin="16,0,0,0" Background="{DynamicResource SparkBgBrush}" CornerRadius="5" HorizontalAlignment="Stretch">
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" HorizontalAlignment="Left" Width="{Binding Cpu, Converter={StaticResource P2W}}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="LeaksText" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- MACHINE -->
            <TabItem Header="🖥️  Machine">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="MachineCopyBtn" Content="📋  Copier" Click="MachineCopy_Click" Margin="0,0,8,0" Padding="12,6"/>
                                        <Button x:Name="MachineScanBtn" Content="🔍  Re-scanner" Click="MachineScan_Click" Padding="12,6"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MachineTitle" Text="Ma machine" Style="{StaticResource SectionTitle}" Margin="0"/>
                                </DockPanel>
                                <TextBlock x:Name="MachineSub" Style="{StaticResource Hint}" Text="Inventaire matériel détecté au démarrage. PerfMonitor adapte ses cartes, ses seuils par défaut et les conseils à ce matériel."/>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="MachinePanel">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PARAMÈTRES -->
            <TabItem Header="⚙️  Paramètres">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsPanel" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="🔔  Notifications" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Écran des notifications" VerticalAlignment="Center" Margin="0,6"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                    <ComboBox ItemsSource="{Binding ScreenModes}" SelectedIndex="{Binding ScreenModeIndex}" Width="230"/>
                                    <ComboBox ItemsSource="{Binding ScreenNames}" SelectedIndex="{Binding ScreenIndex}" Width="200" Margin="8,0,0,0" Visibility="{Binding ScreenIndexVisible}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Coin de l'écran" VerticalAlignment="Center" Margin="0,6"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Corners}" SelectedIndex="{Binding CornerIndex}" Width="230" HorizontalAlignment="Left" Margin="0,6"/>
                                <TextBlock Grid.Row="2" Text="Durée d'affichage (s, 0 = jusqu'au clic)" VerticalAlignment="Center" Margin="0,6"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ToastSec, UpdateSourceTrigger=LostFocus}" Width="70" HorizontalAlignment="Left" Margin="0,6"/>
                                <TextBlock Grid.Row="3" Text="Délai mini entre 2 alertes identiques (min)" VerticalAlignment="Center" Margin="0,6"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CooldownMin, UpdateSourceTrigger=LostFocus}" Width="70" HorizontalAlignment="Left" Margin="0,6"/>
                            </Grid>
                            <CheckBox IsChecked="{Binding Sound}" Content="Jouer un son à chaque notification" Margin="0,10,0,0"/>
                            <CheckBox IsChecked="{Binding NotifyRecovery}" Content="Prévenir aussi quand ça revient à la normale" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ScreensInfo" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="👤  Profils de seuils" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Trois jeux de seuils : Travail, Jeu (seuils relevés, seules les alertes critiques sont notifiées) et Nuit (CPU/RAM/réseau muets, températures et disques surveillés). Les cartes de l'onglet Live modifient le profil actif. Changement rapide : pastille dans la barre de titre ou icône de la zone de notification."/>
                            <CheckBox IsChecked="{Binding ProfileAuto}" Content="Choisir automatiquement : « Jeu » quand un jeu tourne, « Nuit » la nuit, sinon « Travail »"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Nuit de" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding NightStart, UpdateSourceTrigger=LostFocus}" Width="44" TextAlignment="Right"/>
                                <TextBlock Text="h à" VerticalAlignment="Center" Margin="6,0,6,0"/><TextBox Text="{Binding NightEnd, UpdateSourceTrigger=LostFocus}" Width="44" TextAlignment="Right"/><TextBlock Text="h" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="🎮  Jeux, overlay et widget" Style="{StaticResource SectionTitle}"/>
                            <CheckBox IsChecked="{Binding GameAutoDetect}" Content="Détecter automatiquement une application plein écran comme un jeu"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Jeux (noms de processus, séparés par des virgules) :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding GamesText, UpdateSourceTrigger=LostFocus}" Width="320" ToolTip="ex : javaw, MinecraftLauncher, cs2, eldenring"/>
                                <Button Content="Ajouter l'appli au premier plan dans 5 s" Margin="8,0,0,0" Padding="10,4" Click="AddForeground_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="GameInfo" Style="{StaticResource Hint}"/>
                            <CheckBox IsChecked="{Binding OverlayEnabled}" Content="Afficher le bandeau overlay (CPU / températures / RAM / disque) en haut de l'écran des notifications pendant le jeu" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Pendant une session : notifications réduites aux critiques, profil « Jeu » si automatique, rapport de session à la fin (toast + onglet Historique)."/>
                            <Separator Margin="0,12" Background="{DynamicResource GridBrush}"/>
                            <CheckBox IsChecked="{Binding WidgetEnabled}" Content="Widget flottant toujours visible (CPU · temp · GPU · RAM · disque) — déplaçable à la souris"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Opacité du widget" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Value="{Binding WidgetOpacity}" Minimum="0.3" Maximum="1" Width="200" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                <Button Content="Ramener sur l'écran des notifications" Margin="10,0,0,0" Padding="10,4" Click="WidgetReset_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="✈️  Telegram et bilan quotidien" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="1) Dans Telegram, parle à @BotFather → /newbot → copie le token. 2) Envoie n'importe quel message à ton nouveau bot. 3) Colle le token ci-dessous puis clique « Détecter mon chat ID ». Le token est chiffré sur ce PC (DPAPI)."/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Token du bot" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox Grid.Column="1" Text="{Binding TelegramToken, UpdateSourceTrigger=LostFocus}" Margin="0,4" Width="420" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="1" Text="Chat ID" VerticalAlignment="Center" Margin="0,4"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=LostFocus}" Width="160"/>
                                    <Button Content="Détecter mon chat ID" Margin="8,0,0,0" Padding="10,4" Click="TgDetect_Click"/>
                                    <Button Content="Envoyer un test" Margin="8,0,0,0" Padding="10,4" Click="TgTest_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TgStatus" Style="{StaticResource Hint}"/>
                            <CheckBox IsChecked="{Binding TelegramCritical}" Content="Envoyer les alertes critiques sur Telegram" Margin="0,8,0,0"/>
                            <CheckBox IsChecked="{Binding TelegramDigest}" Content="Envoyer le bilan quotidien sur Telegram" Margin="0,8,0,0"/>
                            <Separator Margin="0,12" Background="{DynamicResource GridBrush}"/>
                            <CheckBox IsChecked="{Binding DigestEnabled}" Content="Bilan de la veille en notification (à la première session après 7 h)"/>
                            <Button Content="Voir le bilan de la veille maintenant" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Digest_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="🎨  Apparence" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Thème" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" Width="200"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding Compact}" Content="Mise en page compacte (cartes plus petites, plus de colonnes)" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="🏁  Benchmark rapide (≈ 40 s)" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="CPU (SHA-256 multi et mono-thread), mémoire (copie), disque (1 Go séquentiel + 4 Ko aléatoire, fichier temporaire supprimé ensuite). Lance-le à deux moments comparables (PC au repos) pour mesurer l'effet d'un réglage BIOS. Un marqueur « Benchmark » est ajouté à l'historique."/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Disque à tester :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="BenchDisk" Width="90"/>
                                <Button x:Name="BenchBtn" Content="▶ Lancer le benchmark" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Bench_Click"/>
                                <TextBlock x:Name="BenchStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <ItemsControl x:Name="BenchRows" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Now}" FontWeight="SemiBold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Prev}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Best}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Delta}" Foreground="{Binding DeltaBrush}" TextAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="🚀  Démarrage et conseiller" Style="{StaticResource SectionTitle}"/>
                            <CheckBox IsChecked="{Binding StartWithWindows}" Content="Lancer PerfMonitor Live avec Windows (réduit dans la zone de notification)"/>
                            <CheckBox IsChecked="{Binding ShowAdvisor}" Content="Afficher le conseiller (mascotte et bulles de conseils sur l'onglet Live)" Margin="0,8,0,0"/>
                            <Button Content="Réafficher tous les conseils écartés" HorizontalAlignment="Left" Margin="0,10,0,0" Click="AdvReset_Click"/>
                            <CheckBox IsChecked="{Binding EcoAuto}" Content="Mode économie automatique : 1 mesure toutes les 2 s (au lieu de 1 s) sur batterie ou fenêtre fermée depuis plus de 5 min" Margin="0,12,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Text="L'historique (5 s), les alertes et les rapports ne changent pas ; seule la fluidité du Live est réduite quand personne ne le regarde. Retour à 1 s dès que la fenêtre s'ouvre."/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="L'historique est enregistré toutes les 5 s dans le dossier data\. Fermer la fenêtre ne quitte pas l'application (elle reste dans la zone de notification)."/>
                            <Button Content="Revoir le guide de démarrage" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Welcome_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="⬆️  Mises à jour" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding VersionText}"/>
                            <CheckBox IsChecked="{Binding UpdateAuto}" Content="Vérifier automatiquement une fois par jour (dernière Release GitHub — rien n'est installé sans toi)" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="UpdateBtn" Content="Vérifier maintenant" Click="Update_Click"/>
                                <Button x:Name="UpdateOpenBtn" Content="Ouvrir la page de téléchargement" Margin="8,0,0,0" Click="UpdateOpen_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateText" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
