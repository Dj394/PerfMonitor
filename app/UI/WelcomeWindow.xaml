<Window x:Class="PerfMonitorLive.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue dans PerfMonitor" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}"/><Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GridBrush}" BorderThickness="1" CornerRadius="16" Padding="26,22" Margin="12">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#000000" Opacity="0.55"/></Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <Border Width="44" Height="44" CornerRadius="12" Background="#1E2A44" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Image Source="pack://application:,,,/app-icon.png" Stretch="Uniform" Margin="6"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Bienvenue dans PerfMonitor" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TitleFgBrush}"/>
                    <TextBlock x:Name="Sub" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
            <StackPanel x:Name="Points" Margin="0,4,0,6"/>
            <DockPanel Margin="0,14,0,0">
                <CheckBox x:Name="ShowAgain" Content="Revoir ce guide au prochain lancement" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Voir ma machine" Click="Machine_Click" Padding="14,7" Margin="0,0,8,0"/>
                    <Button Content="C'est parti !" Click="Ok_Click" Padding="18,7" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
